"""Curated landmarks the route agent may use. Generated by tools/build_geo.py from
tools/landmark_seed.py; edit the seed, not this file.

Draft list: lighting and surface are best guesses. Check them on the ground
before the agent's safety notes rely on them.
"""

obj Landmark {
    has name: str,
        area: str,
        description: str,
        lighting: str,
        surface: str,
        good_times: list[str],
        tags: list[str] = [];
}

glob ALL_DAY: list[str] = ["morning", "afternoon", "evening"];
glob DAYTIME: list[str] = ["morning", "afternoon"];

"""Tags a landmark can carry; the preference parser may only use these."""
glob TAGS: list[str] = [
         "river",
         "park",
         "nature",
         "trail",
         "campus",
         "shops",
         "historic",
         "quiet",
         "busy",
         "stadium",
         "track",
         "hill",
         "flat"
     ];

glob AREAS: list[str] = ["central-campus", "north-campus", "downtown"];

