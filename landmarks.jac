"""Landmarks whose home area is `area`; an unknown area has none."""
def landmarks_for(area: str) -> list[Landmark] {
    return [
        lm
        for lm in all_landmarks()
        if lm.area == area
    ];
}

"""The landmark with this exact name, or None."""
def landmark_named(name: str) -> Landmark | None {
    for lm in all_landmarks() {
        if lm.name == name {
            return lm;
        }
    }
    return None;
}
