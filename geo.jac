"""Route geometry: the code, not the LLM, measures every candidate route.

Data (coordinates, OSRM walking distances, elevation) lives in geo_data.jac,
generated by tools/build_geo.py. This module turns a pool of landmarks into
measured candidate routes in three shapes:

- loop: start -> stops -> back to start
- out-and-back: start -> stops -> turn around -> same way back
- one-way: start -> stops, finishing at the last stop

A route may be repeated for `laps` only when the pool has nothing long enough.
"""

import itertools;
import math;
import random;
import from geo_data { COORDS, ELEVATION_M, WALK_KM }

"""Paths are longer than straight lines; 1.3 is a common walking detour factor."""
glob DETOUR: float = 1.3,
     LAP_PENALTY: float = 0.25,
     MAX_LAPS: int = 4,
     MIN_STOPS: int = 3,
     MAX_STOPS: int = 6,
     POOL_MAX: int = 13,
     PREF_WEIGHT: float = 0.3,
     SHAPES: list[str] = ["loop", "out-and-back", "one-way"],
     SHAPE_PENALTY: dict[str, float] = {
         "loop": 0.0,
         "out-and-back": 0.03,
         "one-way": 0.08
     };

"""One measured candidate: run the stops in order in the given shape, `laps` times.

`loop_km` is the length of one pass (for out-and-back that already includes the
way back). `climb_m` is the total uphill over the whole route.
"""
obj RouteOption {
    has stops: list[str],
        laps: int,
        loop_km: float,
        distance_km: float,
        shape: str = "loop",
        climb_m: float = 0.0,
        score: float = 0.0;
}

"""Register a place that is not in the data files, such as the runner's own
start address, so routes can begin there.

`walk_km` holds walking distances from the place to landmarks by name; pairs
it does not cover fall back to the straight-line estimate in `leg_km`.
"""
def add_place(
    name: str, lat: float, lon: float, elevation_m: float, walk_km: dict[str, float]
) -> None {
    COORDS[name] = (lat, lon);
    ELEVATION_M[name] = elevation_m;
    for (other, km) in walk_km.items() {
        WALK_KM[f"{name}|{other}"] = km;
    }
}

"""Walking distance between two landmarks in km: measured when we have it, else estimated."""
def leg_km(a: str, b: str) -> float {
    if a == b {
        return 0.0;
    }
    for key in [f"{a}|{b}", f"{b}|{a}"] {
        if key in WALK_KM {
            return WALK_KM[key];
        }
    }
    return straight_km(a, b) * DETOUR;
}

"""Straight-line (great-circle) distance between two landmarks, in km."""
def straight_km(a: str, b: str) -> float {
    (lat1, lon1) = COORDS[a];
    (lat2, lon2) = COORDS[b];
    return straight_km_points(lat1, lon1, lat2, lon2);
}

"""Straight-line distance between two coordinates, in km."""
def straight_km_points(lat1: float, lon1: float, lat2: float, lon2: float) -> float {
    p1 = math.radians(lat1);
    p2 = math.radians(lat2);
    dp = p2 - p1;
    dl = math.radians(lon2 - lon1);
    h = math.sin(dp / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dl / 2) ** 2;
    return 2 * 6371.0 * math.asin(math.sqrt(h));
}

"""Length of the open path through the stops in order, in km."""
def path_km(stops: list[str]) -> float {
    total = 0.0;
    for i in range(len(stops) - 1) {
        total += leg_km(stops[i], stops[i + 1]);
    }
    return total;
}

"""Length of one loop through the stops and back to the first stop, in km."""
def loop_km(stops: list[str]) -> float {
    if len(stops) == 0 {
        return 0.0;
    }
    return path_km(stops) + leg_km(stops[-1], stops[0]);
}

"""Metres of uphill along the stops (and back to the start when closed)."""
def climb_m(stops: list[str], closed: bool) -> float {
    seq = stops + [stops[0]] if closed and len(stops) > 0 else stops;
    total = 0.0;
    for i in range(len(seq) - 1) {
        rise = ELEVATION_M.get(seq[i + 1], 0.0) - ELEVATION_M.get(seq[i], 0.0);
        if rise > 0 {
            total += rise;
        }
    }
    return total;
}

"""Best order for the stops after the fixed first one, by brute force when small
and nearest-neighbour plus 2-opt when there are many."""
def best_order(stops: list[str], closed: bool) -> list[str] {
    first = stops[0];
    rest = stops[1:];
    length = loop_km if closed else path_km;
    if len(rest) <= 4 {
        best: list[str] = stops;
        best_len = length(stops);
        for perm in itertools.permutations(rest) {
            order = [first] + list(perm);
            cand = length(order);
            if cand < best_len {
                best = order;
                best_len = cand;
            }
        }
        return best;
    }
    order = [first];
    left = list(rest);
    while len(left) > 0 {
        nxt = min(left, key=lambda (n: str) { leg_km(order[-1], n); });
        order.append(nxt);
        left.remove(nxt);
    }
    improved = True;
    while improved {
        improved = False;
        for i in range(1, len(order) - 1) {
            for j in range(i + 1, len(order)) {
                trial = order[:i] + order[i:j + 1][::-1] + order[j + 1:];
                if length(trial) < length(order) - 1e-9 {
                    order = trial;
                    improved = True;
                }
            }
        }
    }
    return order;
}

"""Centre of a set of landmarks (mean latitude and longitude)."""
def centroid(names: list[str]) -> tuple[float, float] {
    known = [
        n
        for n in names
        if n in COORDS
    ];
    if len(known) == 0 {
        return (0.0, 0.0);
    }
    lat = sum([COORDS[n][0] for n in known]) / len(known);
    lon = sum([COORDS[n][1] for n in known]) / len(known);
    return (lat, lon);
}

"""Up to POOL_MAX landmarks to build routes from, spread from near to far around
the anchor so short and long routes both have material."""
def pick_pool(
    names: list[str], anchor: tuple[float, float], start: str | None
) -> list[str] {
    known = [
        n
        for n in names
        if n in COORDS and n != start
    ];
    def dist(n: str) -> float {
        return straight_km_points(anchor[0], anchor[1], COORDS[n][0], COORDS[n][1]);
    }
    known.sort(key=dist);
    room = POOL_MAX - (1 if start else 0);
    if len(known) > room {
        step = len(known) / room;
        known = [known[int(i * step)] for i in range(room)];
    }
    return ([start] if start else []) + known;
}

"""Measured candidate routes close to the target distance.

- `start`: a landmark every route must begin at (None: any stop may start).
- `shape`: "loop", "out-and-back", "one-way", or "any".
- `bonus`: per-landmark preference score (positive wanted, negative avoided).
- `climb_weight`: penalty per 100 m of uphill, relative to a 10% distance miss.
Up to `count` options with different stop sets are returned, best first.
"""
def route_options(
    names: list[str],
    target_km: float,
    count: int = 3,
    seed: int | None = None,
    start: str | None = None,
    shape: str = "any",
    bonus: dict[str, float] | None = None,
    climb_weight: float = 0.0
) -> list[RouteOption] {
    if not math.isfinite(target_km) or target_km <= 0 {
        return [];
    }
    if start is not None and start not in COORDS {
        return [];
    }
    anchor = COORDS[start] if start else centroid(names);
    pool = pick_pool(names, anchor, start);
    if len(pool) < MIN_STOPS {
        return [];
    }
    shapes = SHAPES if shape == "any" else [shape];
    prefs = bonus if bonus is not None else {};
    candidates: list[RouteOption] = [];
    fixed = [start] if start else [];
    others = [
        n
        for n in pool
        if n != start
    ];
    for size in range(MIN_STOPS, min(MAX_STOPS, len(pool)) + 1) {
        for combo in itertools.combinations(others, size - len(fixed)) {
            stops = fixed + list(combo);
            for sh in shapes {
                closed = sh == "loop";
                order = best_order(stops, closed);
                one_pass = loop_km(order) if closed else path_km(order);
                if sh == "out-and-back" {
                    one_pass = one_pass * 2;
                }
                if one_pass <= 0 {
                    continue;
                }
                laps = 1
                    if sh == "one-way"
                    else max(1, min(MAX_LAPS, round(target_km / one_pass)));
                climb = climb_m(order, closed) * laps;
                if sh == "out-and-back" {
                    climb = (climb_m(order, False) + climb_m(order[::-1], False))
                        * laps;
                }
                distance = one_pass * laps;
                pref = sum([prefs.get(n, 0.0) for n in order]) / len(order);
                score = abs(distance - target_km) / target_km
                    + LAP_PENALTY * (laps - 1)
                    + SHAPE_PENALTY[sh]
                    - PREF_WEIGHT * pref
                    + climb_weight * climb / 100.0;
                candidates.append(
                    RouteOption(
                        stops=order,
                        laps=laps,
                        loop_km=round(one_pass, 2),
                        distance_km=round(distance, 1),
                        shape=sh,
                        climb_m=round(climb),
                        score=round(score, 4)
                    )
                );
            }
        }
    }
    if len(candidates) == 0 {
        return [];
    }
    candidates.sort(key=lambda (o: RouteOption) { o.score; });
    best = candidates[0].score;
    close = [
        c
        for c in candidates
        if c.score <= best + 0.05
    ][:40];
    rng = random.Random(seed);
    rng.shuffle(close);
    picked: list[RouteOption] = [];
    for option in close + candidates {
        if all([set(option.stops) != set(p.stops) for p in picked]) {
            picked.append(option);
        }
        if len(picked) == count {
            break;
        }
    }
    return picked;
}
